# Obrigatório: sua chave da API do Google Gemini
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="sua-chave-aqui"

# URL pública do app (preenchida automaticamente pelo Railway após primeiro deploy)
APP_URL="https://seu-app.railway.app"

# Segredo para assinar tokens JWT — troque por uma string aleatória longa
JWT_SECRET="troque-por-um-segredo-forte-aqui"

# Caminho do banco SQLite — aponte para o Volume do Railway
# No Railway, crie um Volume montado em /data e use:
DB_PATH="/data/data.db"
